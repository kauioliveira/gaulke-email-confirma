# =============================================================================
# PRODUCAO — notifica.contabilgaulke.com.br
# Copie para .env.production e preencha. NAO versione o arquivo preenchido.
#
# Valores SEM aspas: o --env-file do Docker nao as remove (o dotenv remove).
# O app tolera os dois casos, mas sem aspas evita confusao.
# =============================================================================

# Base publica de TODOS os links do e-mail (botao, pixel e logo).
# Com subdominio proprio o app roda na raiz dele, entao NAO existe
# subcaminho e NAO se usa NUXT_APP_BASE_URL.
URL_ACESSO=https://notifica.contabilgaulke.com.br

# Postgres de PRODUCAO (o sistema usa apenas tabelas sys_mail_*)
DATABASE_URL=postgresql://usuario:senha@host:5432/banco

# SMTP da empresa
NUXT_SMTP_ENABLED=true
NUXT_SMTP_HOST=mail.contabilgaulke.com.br
NUXT_SMTP_PORT=587
NUXT_SMTP_SECURE=false
NUXT_SMTP_REQUIRE_TLS=true
NUXT_SMTP_REJECT_UNAUTHORIZED=true
NUXT_SMTP_USER=notifica@contabilgaulke.com.br
NUXT_SMTP_PASS=
NUXT_SMTP_FROM=Gaulke Notifica <notifica@contabilgaulke.com.br>
NUXT_SMTP_REPLY_TO=contato@contabilgaulke.com.br

# Area administrativa — use uma senha DIFERENTE da de desenvolvimento.
# O shell/build-image-production.sh aborta se estiver em branco.
ADMIN_PASSWORD=
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# PDFs dos lotes. No Docker isto e um volume; fora dele, uma pasta
# que sobreviva ao deploy (nao dentro do diretorio do build).
STORAGE_DIR=./storage/files

# Porta que o docker-compose ABRE no host (so no loopback).
# E o endereco que o proxy reverso consulta: se mudar aqui, mude no vhost.
APP_HOST_PORT=8551

# Dentro do conteiner o Nitro escuta sempre em 3000; nao mexa.
PORT=3000

# Somente DESENVOLVIMENTO: hosts extras aceitos pelo servidor do Vite, alem do
# host derivado de URL_ACESSO. Separados por virgula. Irrelevante em producao.
# DEV_HOSTS=homologa.contabilgaulke.com.br
