# ===========================================
# PostgreSQL principal com Drizzle ORM -> server/db/main
# ===========================================
# Conexao do PostgreSQL principal usada pelo Drizzle.
DATABASE_URL=postgresql://postgres:kaui@192.168.0.12:5432/db_gaulke_contabil_dev


# ===========================================
# SMTP da empresa -> server/utils/notifications/mailer.ts
# ===========================================
NUXT_SMTP_ENABLED=true
NUXT_SMTP_HOST=mail.contabilgaulke.com.br
NUXT_SMTP_PORT=587
# secure=true apenas para porta 465 (SMTPS). Em 587 use secure=false + requireTls=true.
NUXT_SMTP_SECURE=false
NUXT_SMTP_REQUIRE_TLS=true
# Mantenha true em producao. Use false somente para servidores com certificado interno.
NUXT_SMTP_REJECT_UNAUTHORIZED=true
NUXT_SMTP_USER=notifica@contabilgaulke.com.br
NUXT_SMTP_PASS='j9eaNp9l?qsr@y>u'
NUXT_SMTP_FROM="Gaulke Notifica <notifica@contabilgaulke.com.br>"
NUXT_SMTP_REPLY_TO=dev@contabilgaulke.com.br


#URL_ACESSO="https://notifica.contabilgaulke.com.br"
URL_ACESSO="http://192.168.0.64:2005/"


# =============================================================================
# Area administrativa -> server/utils/auth.ts
# =============================================================================
# Senha unica de acesso a /admin. Troque por uma de sua preferencia.
ADMIN_PASSWORD=kaui
# e-mail dos avisos "quem pediu" para o que for criado pela senha local
SENHA_LOCAL_EMAIL=kaui@contabilgaulke.com.br
# Segredo do cookie de sessao. Trocar invalida as sessoes abertas.
SESSION_SECRET="t4tDmM3u8kFWPL18fG8JZF2J47ioYCiDRB0KJZKk6PJUtbhYFqCY7zucw3poUGt9bsqYLg2ZCXRq"

# Diretorio PRIVADO dos PDFs. Fica fora de public/ de proposito: o download
# so acontece pela rota com token, e assim fica rastreado.
STORAGE_DIR=./storage/files

# WhatsApp da empresa no botao flutuante da pagina do destinatario.
# Formato internacional, so digitos: 55 + DDD + numero. Vazio esconde o botao.
WHATSAPP_NUMERO=554730127300

# Porta do servidor de DESENVOLVIMENTO (npm run dev). As portas de homologacao
# e producao ficam em shell/deploy.conf, porque sao dos servidores, nao daqui.
PORT=2005

# --- Entrada pela sessao do painel (opcional) ---
# Nome do cookie que o painel grava para *.contabilgaulke.com.br. So mude se
# o painel mudar o dele; caso contrario deixamos de reconhecer a sessao.
PAINEL_COOKIE_SESSAO=gaulke_auth_session
# Link "voltar ao painel" mostrado a quem entra sem permissao. Vazio esconde.
PAINEL_URL=https://dev-painel.contabilgaulke.com.br


# Chave que cifra as senhas das contas de envio (AES-256-GCM).
# Gerada com: openssl rand -hex 32
# CUIDADO: e ela que abre as senhas gravadas no banco. Toda maquina que
# usar o MESMO banco precisa da MESMA chave; trocar invalida o que ja existe.
SMTP_CRYPTO_KEY="826edec2e46d2f75b6dd310b5947b03d5912af038430d0650507790469321d98"

# Imagens do corpo do e-mail (publicas, servidas por /img/). Precisa de volume.
IMAGENS_DIR=./storage/imagens

# Acesso de emergencia pela ADMIN_PASSWORD (painel fora do ar): true so no desenvolvimento
ACESSO_EMERGENCIA=true
