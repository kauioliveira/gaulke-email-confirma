# ===========================================
# PostgreSQL principal com Drizzle ORM -> server/db/main
# ===========================================
# Conexao do PostgreSQL principal usada pelo Drizzle.
DATABASE_URL=

# ===========================================
# SMTP da empresa -> server/utils/notifications/mailer.ts
# ===========================================
NUXT_SMTP_ENABLED=
NUXT_SMTP_HOST=
NUXT_SMTP_PORT=
# secure=true apenas para porta 465 (SMTPS). Em 587 use secure=false + requireTls=true.
NUXT_SMTP_SECURE=
NUXT_SMTP_REQUIRE_TLS=
# Mantenha true em producao. Use false somente para servidores com certificado interno.
NUXT_SMTP_REJECT_UNAUTHORIZED=
NUXT_SMTP_USER=
NUXT_SMTP_PASS=
NUXT_SMTP_FROM=
NUXT_SMTP_REPLY_TO=
URL_ACESSO=
# =============================================================================
# Area administrativa -> server/utils/auth.ts
# =============================================================================
# Senha unica de acesso a /admin. Troque por uma de sua preferencia.
ADMIN_PASSWORD=
# Opcional: e-mail que recebe os avisos (documentos prontos, assinou, recusou)
# do que for criado pela senha local. Vazio = esses avisos nao saem.
SENHA_LOCAL_EMAIL=
# Segredo do cookie de sessao. Trocar invalida as sessoes abertas.
SESSION_SECRET=
# Diretorio PRIVADO dos PDFs. Fica fora de public/ de proposito: o download
# so acontece pela rota com token, e assim fica rastreado.
STORAGE_DIR=

# Diretorio das imagens usadas no corpo do e-mail. Diferente do STORAGE_DIR:
# estas sao PUBLICAS (servidas por /img/) porque o cliente de e-mail as busca
# de fora. Vazio usa ./storage/imagens. Em producao precisa de volume.
IMAGENS_DIR=

# Documentos que os CLIENTES enviam pelas solicitacoes, organizados por
# cliente (clientes/<CPF-ou-CNPJ>_<nome>/<ano>/SOL-000123_<titulo>/...).
# Privado: o download so acontece pela area autenticada. Vazio usa
# ./storage/documentos. Em producao precisa de volume.
DOCUMENTOS_DIR=

# Antivirus (ClamAV, servico `clamav` do docker-compose). Todo arquivo que um
# cliente envia fica em quarentena ate o clamd liberar. Vazio = sem antivirus:
# o arquivo passa, marcado como "nao verificado" (so para desenvolvimento).
CLAMAV_HOST=
CLAMAV_PORT=3310


# Porta do servidor de DESENVOLVIMENTO (npm run dev). As portas de homologacao
# e producao ficam em shell/deploy.conf, porque sao dos servidores, nao daqui.
PORT=2005

# --- Entrada pela sessao do painel (opcional) ---
# Nome do cookie que o painel grava para *.contabilgaulke.com.br. So mude se
# o painel mudar o dele; caso contrario deixamos de reconhecer a sessao.
PAINEL_COOKIE_SESSAO=gaulke_auth_session
# Link "voltar ao painel" mostrado a quem entra sem permissao. Vazio esconde.
PAINEL_URL=https://painel.contabilgaulke.com.br

# Chave que cifra as senhas das contas de envio (AES-256-GCM). Obrigatoria para
# cadastrar contas pela tela de Configuracoes. Gere a sua com:
#   openssl rand -hex 32
# Toda maquina que usar o MESMO banco precisa da MESMA chave.
SMTP_CRYPTO_KEY=

# --- Chamados no painel (opcional) ---
# Preferencialmente configurado pela tela (Configuracoes -> Integracao com o
# painel), onde o token fica CIFRADO no banco. Estas variaveis so valem quando
# a tela nao foi configurada. O token e gerado no painel em Configuracoes ->
# Tokens de API, por um admin (ou com o scope integracao:comunica).
PAINEL_API_URL=
PAINEL_API_TOKEN=
