# ===========================================
# PostgreSQL principal com Drizzle ORM -> server/db/main
# ===========================================
# Conexao do PostgreSQL principal usada pelo Drizzle.
DATABASE_URL=

# ===========================================
# SMTP da empresa -> server/utils/notifications/mailer.ts
# ===========================================
NUXT_SMTP_ENABLED=
NUXT_SMTP_HOST=
NUXT_SMTP_PORT=
# secure=true apenas para porta 465 (SMTPS). Em 587 use secure=false + requireTls=true.
NUXT_SMTP_SECURE=
NUXT_SMTP_REQUIRE_TLS=
# Mantenha true em producao. Use false somente para servidores com certificado interno.
NUXT_SMTP_REJECT_UNAUTHORIZED=
NUXT_SMTP_USER=
NUXT_SMTP_PASS=
NUXT_SMTP_FROM=
NUXT_SMTP_REPLY_TO=
URL_ACESSO=
# =============================================================================
# Area administrativa -> server/utils/auth.ts
# =============================================================================
# Senha unica de acesso a /admin. Troque por uma de sua preferencia.
ADMIN_PASSWORD=
# Segredo do cookie de sessao. Trocar invalida as sessoes abertas.
SESSION_SECRET=
# Diretorio PRIVADO dos PDFs. Fica fora de public/ de proposito: o download
# so acontece pela rota com token, e assim fica rastreado.
STORAGE_DIR=

